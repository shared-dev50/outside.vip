# Outside.vip Server Environment Variables
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://username:password@localhost:5432/outside_vip?schema=public"

# Auth
JWT_SECRET="your-jwt-secret-here-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Client URL & CORS Allowed Origins
# Primary client origin (e.g. "https://outside-vip.vercel.app" for production, "http://localhost:5173" for dev)
CLIENT_URL="http://localhost:5173"
# Optional additional allowed origins, comma-separated (e.g. "https://outside-vip.vercel.app, https://outside.vip")
ALLOWED_ORIGINS="https://outside-vip.vercel.app"

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PLATFORM_COMMISSION_PERCENT="5"

# Email Delivery
EMAIL_FROM="tickets@outside.vip"

# Cloudinary (Event Cover Images)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_FOLDER=outside-vip/event-covers
