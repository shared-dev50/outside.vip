# Outside.vip Server Environment Variables
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://username:password@localhost:5432/outside_vip?schema=public"

# Auth & Admin Provisioning
JWT_SECRET="your-jwt-secret-here-at-least-32-chars"
JWT_EXPIRES_IN="7d"
# Comma-separated allowlist of verified email addresses that are automatically provisioned with ADMIN privileges
ADMIN_EMAILS="admin@outside.vip"

# Client URL & CORS Allowed Origins
# Primary client origin (e.g. "https://outside-vip.vercel.app" for production, "http://localhost:5173" for dev)
CLIENT_URL="http://localhost:5173"
# Optional additional allowed origins, comma-separated (e.g. "https://outside-vip.vercel.app, https://outside.vip")
ALLOWED_ORIGINS="https://outside-vip.vercel.app"

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PLATFORM_COMMISSION_PERCENT="5"

# Email Delivery (Recommended production provider: Resend - https://resend.com)
EMAIL_FROM="Outside.vip <no-reply@outside.vip>"
# Set RESEND_API_KEY in production to send live 6-digit OTP verification and waitlist emails via Resend REST API
RESEND_API_KEY=""

# Cloudinary (Event Cover Images)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_FOLDER=outside-vip/event-covers

# Google Places API (Event Venue Autocomplete & Verification)
GOOGLE_PLACES_API_KEY=""
# Default country code restriction for Google Places autocomplete (e.g. "US", "KE", or leave empty/set to "ALL" for worldwide)
DEFAULT_PLACES_COUNTRY_CODE="US"
