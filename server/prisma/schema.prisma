// Outside.vip - Core Data Model
// Normalized PostgreSQL Schema with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum EventStaffStatus {
  ACTIVE
  REVOKED
}

enum StaffInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum EventCategory {
  MUSIC
  NIGHTLIFE
  FESTIVAL
  TECH
  ARTS_CULTURE
  FOOD_DRINK
  SPORTS
  COMMUNITY
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum EventFeatureType {
  PERFORMER
  SPONSOR
  SPEAKER
  HOST
  OTHER
}

enum WaitlistEntryStatus {
  WAITING
  OFFERED
  PURCHASED
  EXPIRED
  DECLINED
  CANCELLED
}

enum WaitlistOfferStatus {
  PENDING
  ACCEPTED
  EXPIRED
  DECLINED
  CANCELLED
}

enum TicketTierStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
  HIDDEN
}

enum ReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MPESA
  FREE
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CheckInResult {
  SUCCESS
  ALREADY_CHECKED_IN
  INVALID_TOKEN
  WRONG_EVENT
  CANCELLED_TICKET
  REFUND_PENDING_TICKET
  REFUNDED_TICKET
  TICKET_NOT_YET_VALID
  TICKET_EXPIRED
}

enum LedgerEntryType {
  TICKET_SALE_PENDING
  TICKET_SALE_CLEARED
  TRANSFER_INITIATED
  TRANSFER_SUCCEEDED
  TRANSFER_FAILED
  REFUND_PENDING
  REFUND_CLEARED
  REFUND_POST_TRANSFER
  DISPUTE_HOLD
  DISPUTE_WON
  DISPUTE_LOST
  PLATFORM_FEE
  SERVICE_FEE
  STRIPE_PROCESSING_FEE
  ADJUSTMENT
}

enum LedgerBalanceType {
  PENDING
  AVAILABLE
  TRANSFERRED
  PLATFORM_REVENUE
  PLATFORM_EXPENSE
  RECOVERABLE
}

enum TransferStatus {
  PENDING
  SUCCEEDED
  FAILED
  REVERSED
}

enum TransferSourceType {
  MANUAL_ORGANIZER_REQUEST
  ADMIN_INITIATED
  AUTOMATIC_SCHEDULED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  passwordHash         String?
  name                 String
  role                 Role          @default(ATTENDEE)
  status               AccountStatus @default(ACTIVE)
  emailVerified        Boolean       @default(false)
  emailVerifiedAt      DateTime?
  avatarUrl            String?
  stripeAccountId                  String?       @unique
  stripeAccountCountry             String?
  stripeAccountDefaultCurrency     String?
  stripeAccountDetailsSubmitted    Boolean       @default(false)
  stripeAccountChargesEnabled      Boolean       @default(false)
  stripeAccountPayoutsEnabled      Boolean       @default(false)
  stripeAccountTransfersCapability String?
  stripeAccountDisabledReason      String?
  stripeAccountCapabilities        Json?
  stripeAccountRequirements        Json?
  stripeAccountEventCreatedAt      Int?
  stripeAccountSyncedAt            DateTime?
  stripeAccountCreationKey         String?
  stripeAccountCreationLockedBy    String?
  stripeAccountCreationLockedUntil DateTime?
  stripeAccountCreationStartedAt   DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organizer          OrganizerProfile?
  payoutDetails      OrganizerPayoutDetails?
  events             Event[]                 @relation("OrganizerEvents")
  eventSeries        EventSeries[]           @relation("OrganizerSeries")
  orders             Order[]
  checkIns           CheckInLog[]            @relation("ScannerLogs")
  ticketsScanned     Ticket[]                @relation("ScannerTickets")
  balance            OrganizerBalance?
  ledgerEntries      FinancialLedgerEntry[]  @relation("OrganizerLedger")
  transfers          OrganizerTransfer[]     @relation("OrganizerTransfers")
  initiatedTransfers OrganizerTransfer[]     @relation("InitiatedTransfers")
  connectedPayouts   ConnectedPayout[]       @relation("OrganizerPayouts")
  verificationCodes  EmailVerificationCode[]
  adminAuditLogs     AdminAuditLog[]         @relation("AdminActorLogs")

  staffAssignments        EventStaff[]           @relation("StaffMemberAssignments")
  staffAssignmentsCreated EventStaff[]           @relation("StaffAssignmentsCreated")
  staffAssignmentsRevoked EventStaff[]           @relation("StaffAssignmentsRevoked")
  staffInvitationsSent    EventStaffInvitation[] @relation("StaffInvitationsSent")

  eventTeamMemberships  EventTeamMember[]      @relation("UserEventTeamMembers")
  teamMembersInvited    EventTeamMember[]      @relation("TeamMemberInvitedBy")
  teamInvitationsSent   EventTeamInvitation[]  @relation("TeamInvitationsSent")
  promotionLinksCreated PromotionLink[]        @relation("PromotionLinksCreated")
  initiatedRefunds      OrderRefund[]          @relation("InitiatedRefunds")

  @@index([email])
}

model EmailVerificationCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorUser   User?    @relation("AdminActorLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model OrganizerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  slug            String   @unique
  bio             String?  @db.Text
  websiteUrl      String?
  instagramHandle String?
  twitterHandle   String?
  logoUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Event {
  id          String        @id @default(uuid())
  slug        String        @unique
  organizerId String
  organizer   User          @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Restrict)
  title       String
  tagline     String?
  description String        @db.Text
  category    EventCategory @default(MUSIC)
  status      EventStatus   @default(DRAFT)

  coverImageUrl      String
  coverImagePublicId String?
  thumbnailUrl       String?

  venueName    String
  venueAddress String
  city         String
  country      String  @default("Kenya")
  latitude     Float?
  longitude    Float?
  placeId      String?

  startAt  DateTime
  endAt    DateTime
  timezone String   @default("Africa/Nairobi")

  ageRestriction String? @default("18+")
  dressCode      String?
  isFeatured     Boolean @default(false)

  // Presentation, media & privacy settings
  youtubeVideoId      String?
  youtubeVideoUrl     String?
  showOnExplore       Boolean @default(true)
  hideGuestCount      Boolean @default(false)
  isPasswordProtected Boolean @default(false)
  passwordHash        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketTiers     TicketTier[]
  orders          Order[]
  tickets         Ticket[]
  checkInLogs     CheckInLog[]
  galleryImages   EventGalleryImage[]
  features        EventFeature[]
  waitlistEntries TicketWaitlistEntry[]
  waitlistOffers  TicketWaitlistOffer[]
  payoutDetailsId String?
  payoutDetails   OrganizerPayoutDetails? @relation(fields: [payoutDetailsId], references: [id], onDelete: SetNull)
  ledgerEntries   FinancialLedgerEntry[]

  seriesId        String?
  series          EventSeries? @relation("SeriesEvents", fields: [seriesId], references: [id], onDelete: SetNull)
  occurrenceIndex Int?
  isCustomized    Boolean      @default(false)

  staffAssignments EventStaff[]           @relation("EventStaffAssignments")
  staffInvitations EventStaffInvitation[] @relation("EventStaffInvitations")

  teamMembers         EventTeamMember[]             @relation("EventTeamMembers")
  teamInvitations     EventTeamInvitation[]         @relation("EventTeamInvitations")
  promotionLinks      PromotionLink[]
  promotionClicks     PromotionClick[]
  visitorAttributions PromotionVisitorAttribution[]
  visitorDays         PromotionVisitorDay[]
  dailyAggregates     PromotionDailyAggregate[]

  @@index([slug])
  @@index([category, status])
  @@index([city, status])
  @@index([startAt])
  @@index([isFeatured, status])
  @@index([seriesId])
  @@index([showOnExplore, status])
  @@index([placeId])
}

model EventSeries {
  id                  String              @id @default(uuid())
  organizerId         String
  organizer           User                @relation("OrganizerSeries", fields: [organizerId], references: [id], onDelete: Restrict)
  title               String
  frequency           RecurrenceFrequency @default(WEEKLY)
  interval            Int                 @default(1)
  byWeekday           Int[]
  startDate           DateTime
  endDate             DateTime?
  count               Int?
  timezone            String              @default("Africa/Nairobi")
  showOnExplore       Boolean             @default(true)
  hideGuestCount      Boolean             @default(false)
  isPasswordProtected Boolean             @default(false)
  passwordHash        String?
  youtubeVideoId      String?
  youtubeVideoUrl     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  events Event[] @relation("SeriesEvents")

  @@index([organizerId])
}

model EventGalleryImage {
  id           String   @id @default(uuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  imageUrl     String
  publicId     String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([eventId, displayOrder])
}

model EventFeature {
  id            String           @id @default(uuid())
  eventId       String
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  type          EventFeatureType @default(PERFORMER)
  imageUrl      String?
  imagePublicId String?
  description   String?          @db.Text
  displayOrder  Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([eventId, displayOrder])
}

model TicketTier {
  id               String           @id @default(uuid())
  eventId          String
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name             String
  description      String?          @db.Text
  priceInCents     Int              @default(0) // 0 indicates free ticket
  currency         String           @default("USD")
  totalCapacity    Int
  reservedQuantity Int              @default(0)
  soldQuantity     Int              @default(0)
  minPerOrder      Int              @default(1)
  maxPerOrder      Int              @default(10)
  salesStartAt     DateTime?
  salesEndAt       DateTime?
  validityStartAt  DateTime?
  validityEndAt    DateTime?
  status           TicketTierStatus @default(ACTIVE)
  isHidden         Boolean          @default(false)
  salesDisabled    Boolean          @default(false)
  waitlistEnabled  Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems      OrderItem[]
  tickets         Ticket[]
  reservations    TicketReservation[]
  waitlistEntries TicketWaitlistEntry[]
  waitlistOffers  TicketWaitlistOffer[]

  @@index([eventId])
}

model TicketReservation {
  id           String            @id @default(uuid())
  ticketTierId String
  ticketTier   TicketTier        @relation(fields: [ticketTierId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity     Int
  expiresAt    DateTime
  status       ReservationStatus @default(ACTIVE)
  createdAt    DateTime          @default(now())

  @@index([ticketTierId, status])
  @@index([expiresAt, status])
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique // e.g. "OUT-2026-92813"
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  status      OrderStatus @default(PENDING)

  customerEmail String
  customerName  String
  customerPhone String?

  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?

  totalInCents Int
  currency     String @default("USD")

  platformFeeInCents  Int     @default(0)
  organizerNetInCents Int     @default(0)
  refundedAmountInCents       Int @default(0)
  pendingRefundAmountInCents Int @default(0)
  orderAccessToken    String? @unique

  idempotencyKey   String          @unique
  paymentProvider  PaymentProvider @default(STRIPE)
  paymentReference String? // e.g. Stripe Checkout Session ID or M-Pesa CheckoutRequestID
  stripeFundsAvailableAt           DateTime?
  stripeSettledChargeId            String?
  stripeBalanceTransactionId       String?
  stripeAvailableOn                DateTime?
  stripeSettlementStatus           StripeSettlementStatus?
  stripeSettlementAttempts         Int                     @default(0)
  stripeSettlementNextAttemptAt    DateTime?
  stripeSettlementLockedBy         String?
  stripeSettlementLockedUntil      DateTime?
  stripeSettlementLastErrorCategory String?
  stripeSettlementLastErrorCode    String?
  stripeSettlementLastErrorMessage String?                 @db.Text
  stripeSettlementLastAttemptAt    DateTime?
  stripeSettlementFailedAt         DateTime?
  stripeActualFeeInCents           Int?
  stripeActualFeeCurrency          String?
  stripeActualFeeRecordedAt        DateTime?
  expiresAt        DateTime // 15-minute checkout reservation hold

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  tickets        Ticket[]
  reservations   TicketReservation[]
  transactions   PaymentTransaction[]
  waitlistOffers TicketWaitlistOffer[]
  ledgerEntries  FinancialLedgerEntry[]
  emailOutbox    EmailOutbox[]
  refunds        OrderRefund[]
  refundTickets  OrderRefundTicket[]

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([eventId, status])
  @@index([expiresAt, status])
  @@index([orderAccessToken])
  @@index([paymentReference])
  @@index([status, paymentProvider, stripeSettlementStatus, stripeSettlementNextAttemptAt])
  @@index([stripeSettlementLockedUntil])
}

model OrderItem {
  id               String     @id @default(uuid())
  orderId          String
  order            Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTierId     String
  ticketTier       TicketTier @relation(fields: [ticketTierId], references: [id], onDelete: Restrict)
  quantity         Int
  unitPriceInCents Int
  subtotalInCents  Int

  @@index([orderId])
}

model Ticket {
  id           String     @id @default(uuid())
  ticketToken  String     @unique // Cryptographically unguessable secure token, e.g. tkt_sec_...
  orderId      String
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketTierId String
  ticketTier   TicketTier @relation(fields: [ticketTierId], references: [id], onDelete: Restrict)

  attendeeName  String
  attendeeEmail String

  status            TicketStatus @default(ISSUED)
  checkedInAt       DateTime?
  checkedInByUserId String?
  checkedInByUser   User?        @relation("ScannerTickets", fields: [checkedInByUserId], references: [id], onDelete: SetNull)

  allocatedGrossInCents         Int?
  allocatedPlatformFeeInCents   Int?
  allocatedServiceFeeInCents    Int?
  allocatedProcessingFeeInCents Int?
  allocatedBuyerTotalInCents    Int?
  refundedAt                    DateTime?
  refundedByUserId              String?
  cancelledAt                   DateTime?
  cancelledByUserId             String?
  cancellationReason            String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkInLogs       CheckInLog[]
  refundAllocations OrderRefundTicket[]

  @@unique([id, orderId])
  @@index([ticketToken])
  @@index([eventId, status])
  @@index([orderId])
}

model CheckInLog {
  id              String        @id @default(uuid())
  ticketId        String?
  ticket          Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scannedToken    String
  scannedByUserId String
  scannedByUser   User          @relation("ScannerLogs", fields: [scannedByUserId], references: [id], onDelete: Restrict)
  result          CheckInResult
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([eventId, createdAt])
  @@index([ticketId])
}

model PaymentTransaction {
  id                    String          @id @default(uuid())
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  providerTransactionId String
  status                PaymentStatus   @default(INITIATED)
  amountInCents         Int
  currency              String
  rawResponse           Json?
  createdAt             DateTime        @default(now())

  @@index([orderId])
  @@index([providerTransactionId])
}

model ProcessedWebhookEvent {
  id          String          @id @default(uuid())
  provider    PaymentProvider
  eventId     String          @unique // Stripe evt_... or MPesa unique TransID
  processedAt DateTime        @default(now())

  @@index([eventId])
}

model OrganizerPayoutDetails {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Organisation Details
  orgType            String // Company, Partnership, NGO/Non-profit, Other
  orgTypeOther       String?
  registeredName     String
  registrationNumber String?
  country            String
  address            String? @db.Text
  contactPersonName  String
  contactEmail       String

  // Payout Bank Details
  accountHolderName      String
  bankName               String
  bankCountry            String
  accountCurrency        String  @default("USD")
  accountNumberMasked    String // e.g. "•••• •••• •••• 1234"
  accountNumberLast4     String // e.g. "1234"
  accountNumberEncrypted String? @db.Text
  bankBranch             String?
  swiftBic               String?
  routingCode            String? // Routing number, Sort code, or local clearing code

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([userId])
}

model TicketWaitlistEntry {
  id            String              @id @default(uuid())
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTierId  String
  ticketTier    TicketTier          @relation(fields: [ticketTierId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String
  customerPhone String?
  quantity      Int                 @default(1)
  status        WaitlistEntryStatus @default(WAITING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  offers TicketWaitlistOffer[]

  @@index([ticketTierId, status, createdAt])
  @@index([eventId, status])
  @@index([customerEmail])
}

model TicketWaitlistOffer {
  id                   String              @id @default(uuid())
  entryId              String
  entry                TicketWaitlistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  eventId              String
  event                Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTierId         String
  ticketTier           TicketTier          @relation(fields: [ticketTierId], references: [id], onDelete: Cascade)
  quantity             Int
  status               WaitlistOfferStatus @default(PENDING)
  tokenHash            String              @unique
  expiresAt            DateTime
  claimedAt            DateTime?
  orderId              String?
  order                Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  notificationSentAt   DateTime?
  notificationAttempts Int                 @default(0)
  notificationError    String?             @db.Text
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([ticketTierId, status, expiresAt])
  @@index([tokenHash])
  @@index([expiresAt, status])
  @@index([entryId])
}

model OrganizerBalance {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pendingBalanceInCents     Int    @default(0)
  availableBalanceInCents   Int    @default(0)
  transferredBalanceInCents Int    @default(0)
  currency                  String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model FinancialLedgerEntry {
  id          String             @id @default(uuid())
  organizerId String
  organizer   User               @relation("OrganizerLedger", fields: [organizerId], references: [id], onDelete: Restrict)
  eventId     String?
  event       Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  transferId  String?
  transfer    OrganizerTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)

  type          LedgerEntryType
  amountInCents Int
  currency      String            @default("USD")
  balanceType   LedgerBalanceType

  stripeReferenceId String?
  description       String
  metadata          Json?

  createdAt DateTime @default(now())

  @@index([organizerId, createdAt])
  @@index([eventId])
  @@index([orderId])
  @@index([transferId])
  @@index([stripeReferenceId])
  @@index([type])
}

model OrganizerTransfer {
  id              String @id @default(uuid())
  transferNumber  String @unique // e.g. "TRF-2026-92813"
  organizerId     String
  organizer       User   @relation("OrganizerTransfers", fields: [organizerId], references: [id], onDelete: Restrict)
  stripeAccountId String

  amountInCents        Int
  reversedAmountInCents Int            @default(0)
  currency             String         @default("USD")
  status               TransferStatus @default(PENDING)
  stripeTransferId     String?        @unique // tr_...

  reconciliationRequired         Boolean   @default(false)
  reconciliationAttempts         Int       @default(0)
  reconciliationNextAttemptAt    DateTime?
  reconciliationLockedBy         String?
  reconciliationLockedUntil      DateTime?
  reconciliationLastAttemptAt    DateTime?
  reconciliationLastErrorCode    String?
  reconciliationLastErrorMessage String?   @db.Text
  lastCreateAttemptAt            DateTime?
  succeededAt                    DateTime?
  failedAt                       DateTime?

  sourceType        TransferSourceType @default(MANUAL_ORGANIZER_REQUEST)
  initiatedByUserId String
  initiatedByUser   User               @relation("InitiatedTransfers", fields: [initiatedByUserId], references: [id], onDelete: Restrict)

  failureCode    String?
  failureMessage String?
  idempotencyKey String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries FinancialLedgerEntry[]

  @@index([organizerId, createdAt])
  @@index([status])
  @@index([status, reconciliationNextAttemptAt])
  @@index([status, reconciliationLockedUntil])
  @@index([stripeTransferId])
  @@index([transferNumber])
}

model ConnectedPayout {
  id              String @id @default(uuid())
  organizerId     String
  organizer       User   @relation("OrganizerPayouts", fields: [organizerId], references: [id], onDelete: Restrict)
  stripeAccountId String
  stripePayoutId  String @unique // po_...

  amountInCents         Int
  currency              String       @default("USD")
  status                PayoutStatus @default(PENDING)
  arrivalDate           DateTime?
  destinationBankMasked String?
  failureCode           String?
  failureMessage        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId, createdAt])
  @@index([stripeAccountId])
  @@index([stripePayoutId])
  @@index([status])
}

model EventStaff {
  id               String           @id @default(uuid())
  eventId          String
  userId           String
  email            String
  status           EventStaffStatus @default(ACTIVE)
  assignedByUserId String
  assignedAt       DateTime         @default(now())
  revokedAt        DateTime?
  revokedByUserId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  event          Event @relation("EventStaffAssignments", fields: [eventId], references: [id], onDelete: Cascade)
  user           User  @relation("StaffMemberAssignments", fields: [userId], references: [id], onDelete: Restrict)
  assignedByUser User  @relation("StaffAssignmentsCreated", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  revokedByUser  User? @relation("StaffAssignmentsRevoked", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([userId, status])
  @@index([eventId, status])
}

model EventStaffInvitation {
  id              String                @id @default(uuid())
  eventId         String
  email           String
  invitedByUserId String
  tokenHash       String                @unique
  status          StaffInvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?

  codeHash     String?
  otpSentAt    DateTime?
  otpExpiresAt DateTime?
  attempts     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event @relation("EventStaffInvitations", fields: [eventId], references: [id], onDelete: Cascade)
  invitedByUser User  @relation("StaffInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([eventId, email])
  @@index([email, status])
}

// ==========================================
// EVENT TEAM & PROMOTIONS ENUMS
// ==========================================

enum EventTeamRole {
  ADMIN
  HOST
}

enum TeamMemberStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PromotionLinkType {
  CAMPAIGN
  HOST
}

enum PromotionLinkStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

// ==========================================
// EVENT TEAM & PROMOTIONS MODELS
// ==========================================

model EventTeamMember {
  id          String           @id @default(uuid())
  eventId     String
  userId      String
  role        EventTeamRole
  status      TeamMemberStatus @default(ACTIVE)
  permissions Json?
  invitedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event           @relation("EventTeamMembers", fields: [eventId], references: [id], onDelete: Cascade)
  user        User            @relation("UserEventTeamMembers", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User?           @relation("TeamMemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  hostedLinks PromotionLink[] @relation("HostTeamMemberLinks")

  @@unique([eventId, userId])
  @@unique([id, eventId])
  @@index([eventId, role, status])
}

model EventTeamInvitation {
  id              String               @id @default(uuid())
  eventId         String
  email           String
  role            EventTeamRole
  tokenHash       String               @unique
  status          TeamInvitationStatus @default(PENDING)
  permissions     Json?
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event @relation("EventTeamInvitations", fields: [eventId], references: [id], onDelete: Cascade)
  invitedByUser User  @relation("TeamInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([eventId, status])
  @@index([email, status])
}

model PromotionLink {
  id           String              @id @default(uuid())
  eventId      String
  type         PromotionLinkType
  status       PromotionLinkStatus @default(ACTIVE)
  name         String
  hostMemberId String?
  createdById  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event        Event                       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  hostMember   EventTeamMember?            @relation("HostTeamMemberLinks", fields: [hostMemberId, eventId], references: [id, eventId], onDelete: Restrict)
  createdBy    User                        @relation("PromotionLinksCreated", fields: [createdById], references: [id], onDelete: Restrict)
  slugRegistry PromotionSlugRegistry[]
  clicks       PromotionClick[]
  attributions PromotionVisitorAttribution[]
  visitorDays  PromotionVisitorDay[]
  aggregates   PromotionDailyAggregate[]

  @@unique([id, eventId])
  @@index([eventId, status])
  @@index([hostMemberId])
}

model PromotionSlugRegistry {
  slug            String        @id
  promotionLinkId String
  isPrimary       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  promotionLink PromotionLink @relation(fields: [promotionLinkId], references: [id], onDelete: Restrict)

  @@index([promotionLinkId])
}

model PromotionVisitorAttribution {
  id                 String        @id @default(uuid())
  visitorIdHash      String
  canonicalVisitorId String
  eventId            String
  promotionLinkId    String
  clickedAt          DateTime      @default(now())
  expiresAt          DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  event         Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  promotionLink PromotionLink @relation(fields: [promotionLinkId, eventId], references: [id, eventId], onDelete: Restrict)

  @@unique([canonicalVisitorId, eventId])
  @@index([visitorIdHash, eventId])
  @@index([promotionLinkId, eventId])
  @@index([expiresAt])
}

model PromotionVisitorDay {
  id                 String        @id @default(uuid())
  eventId            String
  promotionLinkId    String
  canonicalVisitorId String
  visitDate          DateTime      @db.Date
  clickCount         Int           @default(1)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  event         Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  promotionLink PromotionLink @relation(fields: [promotionLinkId, eventId], references: [id, eventId], onDelete: Restrict)

  @@unique([promotionLinkId, canonicalVisitorId, visitDate])
  @@index([eventId, visitDate])
  @@index([promotionLinkId, visitDate])
  @@index([canonicalVisitorId])
}

model PromotionClick {
  id                 String        @id @default(uuid())
  eventId            String
  promotionLinkId    String
  visitorIdHash      String?
  canonicalVisitorId String?
  clickedAt          DateTime      @default(now())
  referrer           String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmTerm            String?
  utmContent         String?
  fbclid             String?
  gclid              String?
  ttclid             String?
  userAgent          String?

  event         Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  promotionLink PromotionLink @relation(fields: [promotionLinkId, eventId], references: [id, eventId], onDelete: Restrict)

  @@index([promotionLinkId, clickedAt])
  @@index([eventId, clickedAt])
  @@index([clickedAt])
}

model PromotionDailyAggregate {
  id                     String        @id @default(uuid())
  eventId                String
  promotionLinkId        String
  date                   DateTime      @db.Date
  uniqueVisitors         Int           @default(0)
  totalClicks            Int           @default(0)
  anonymousClicks        Int           @default(0)
  completedOrders        Int           @default(0)
  ticketsSold            Int           @default(0)
  buyerPaidCents         BigInt        @default(0)
  organizerNetCents      BigInt        @default(0)
  refundedOrders         Int           @default(0)
  refundedTickets        Int           @default(0)
  refundedBuyerCents     BigInt        @default(0)
  refundedOrganizerCents BigInt        @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  event         Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  promotionLink PromotionLink @relation(fields: [promotionLinkId, eventId], references: [id, eventId], onDelete: Restrict)

  @@unique([promotionLinkId, date])
  @@index([eventId, date])
}

// ==========================================
// TRANSACTIONAL EMAIL OUTBOX
// ==========================================

enum EmailOutboxType {
  ORDER_CONFIRMATION
  LATE_PAYMENT_REFUND_CONFIRMED
  LATE_PAYMENT_REFUND_MANUAL_REVIEW
  BUYER_REFUND_CONFIRMED
  BUYER_REFUND_MANUAL_REVIEW
}

enum OrderRefundStatus {
  PENDING
  PROCESSING
  STRIPE_PENDING
  SUCCEEDED
  MANUAL_REVIEW_REQUIRED
  MANUALLY_RESOLVED
  CANCELLED
}

enum OrderRefundKind {
  LATE_PAYMENT
  ORGANIZER_TICKET_REFUND
  ADMIN_TICKET_REFUND
  EVENT_CANCELLATION
  EXTERNAL_STRIPE_RECONCILED
}

enum RefundInitiatorRole {
  SYSTEM
  ORGANIZER
  ADMIN
  STRIPE_WEBHOOK
}

enum RefundFeeBearer {
  NOT_APPLICABLE
  ORGANIZER
  PLATFORM
  SHARED
}

enum OrderRefundTicketLockState {
  ACTIVE_PENDING
  CONFIRMED
  RELEASED
}

enum StripeSettlementStatus {
  PENDING
  SETTLED
  FAILED_PERMANENT
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT // Accepted by email provider (e.g. Resend HTTP 200); does not guarantee inbox delivery
  FAILED_PERMANENT
  CANCELLED // Superseded before dispatch (e.g. manual refund resolved prior to notification)
}

model EmailOutbox {
  id                String            @id @default(uuid())
  dedupeKey         String            @unique // e.g. "order_confirmation:<orderId>"
  type              EmailOutboxType
  status            EmailOutboxStatus @default(PENDING)

  // Preservation strategy (matches FinancialLedgerEntry): deleting an Order sets orderId = NULL
  // so pending or historical confirmation records are never silently deleted.
  orderId           String?
  order             Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  recipientEmail    String
  idempotencyKey    String            @unique // Deterministic provider key, e.g. "order-confirmation:<orderId>"
  templateVersion   Int               @default(1)
  // Immutable fulfillment-time rendering snapshot (must never store orderAccessToken or ticket QR tokens)
  contentSnapshot   Json

  attempts          Int               @default(0)
  maxAttempts       Int               @default(8)
  nextAttemptAt     DateTime          @default(now())
  lockedBy          String?
  lockedUntil       DateTime?

  provider          String?           // "resend" | "test-recorder"
  providerMessageId String?
  lastErrorCode     String?
  lastErrorMessage  String?           @db.Text
  lastAttemptAt     DateTime?
  // Timestamp when the provider accepted the message (HTTP 200), not confirmed inbox delivery.
  sentAt            DateTime?
  failedAt          DateTime?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@index([orderId])
}

// ==========================================
// LATE-PAYMENT AUTOMATIC REFUNDS & DEAD-LETTER QUEUE
// ==========================================

/// Note: PostgreSQL-only CHECK constraints (Order_cumulativeRefundCap_chk,
/// Ticket_persistedAllocation_chk, OrderRefund_amounts_chk, OrderRefundTicket_amounts_chk)
/// and the partial unique index OrderRefundTicket_active_or_confirmed_ticket_key cannot be
/// expressed in Prisma 5 DSL and live in migration SQL; preserve them when running
/// `prisma migrate dev --create-only`.
model OrderRefund {
  id                       String            @id @default(uuid())
  // Preservation strategy (matches FinancialLedgerEntry / EmailOutbox):
  // Nullable so unlinked or anomalous PaymentIntents are never silently discarded.
  // Composite FK on OrderRefundTicket uses ON DELETE RESTRICT ON UPDATE RESTRICT so
  // rows linked to OrderRefundTicket cannot cascade-delete or null orderId.
  orderId                  String?
  order                    Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  stripePaymentIntentId    String
  stripeChargeId           String?
  stripeRefundId           String?           @unique
  idempotencyKey           String            @unique
  refundKind               OrderRefundKind   @default(LATE_PAYMENT)
  initiatorRole            RefundInitiatorRole @default(SYSTEM)
  initiatedByUserId        String?
  initiatedByUser          User?             @relation("InitiatedRefunds", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  feeBearer                RefundFeeBearer   @default(NOT_APPLICABLE)
  refundStripeProcessingFee Boolean          @default(false)

  amountInCents            Int
  ticketSubtotalInCents    Int               @default(0)
  platformFeeReversedInCents Int             @default(0)
  serviceFeeReversedInCents Int              @default(0)
  processingFeeInCents     Int               @default(0)
  organizerDebitInCents    Int               @default(0)
  platformExpenseInCents   Int               @default(0)
  restoreInventory         Boolean           @default(false)
  inventoryRestoredCount   Int               @default(0)

  currency                 String            @default("USD")
  reason                   String
  status                   OrderRefundStatus @default(PENDING)

  attempts                 Int               @default(0)
  maxAttempts              Int               @default(8)
  nextAttemptAt            DateTime          @default(now())
  lockedBy                 String?
  lockedUntil              DateTime?

  lastErrorCategory        String?
  lastErrorCode            String?
  lastErrorMessage         String?           @db.Text
  lastAttemptAt            DateTime?
  succeededAt              DateTime?
  failedAt                 DateTime?
  cancelledAt              DateTime?
  cancellationReason       String?           @db.Text

  requiresManualResolution Boolean           @default(false)
  resolvedAt               DateTime?
  resolvedByUserId         String?
  resolvedByEmail          String?
  resolutionAction         String?
  resolutionNotes          String?           @db.Text
  metadata                 Json?

  refundTickets            OrderRefundTicket[]

  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@unique([id, orderId])
  @@index([stripePaymentIntentId])
  @@index([orderId, refundKind, status])
  @@index([initiatedByUserId])
  @@index([status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@index([requiresManualResolution, resolvedAt])
  @@index([orderId])
}

model OrderRefundTicket {
  id                            String                     @id @default(uuid())
  orderRefundId                 String
  orderRefund                   OrderRefund                @relation(fields: [orderRefundId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: Restrict)
  orderId                       String
  order                         Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ticketId                      String
  ticket                        Ticket                     @relation(fields: [ticketId, orderId], references: [id, orderId], onDelete: Restrict, onUpdate: Restrict)
  lockState                     OrderRefundTicketLockState @default(ACTIVE_PENDING)

  allocatedGrossInCents         Int
  allocatedPlatformFeeInCents   Int
  allocatedServiceFeeInCents    Int
  allocatedProcessingFeeInCents Int
  allocatedBuyerTotalInCents    Int
  refundedAmountInCents         Int
  restoreInventory              Boolean                    @default(false)
  inventoryRestored             Boolean                    @default(false)

  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt

  @@unique([orderRefundId, ticketId])
  @@index([orderId])
  @@index([ticketId, lockState])
}
