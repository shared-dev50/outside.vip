{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/r/:path*",
      "destination": "https://outside-vip.onrender.com/r/:path*"
    },
    {
      "source": "/events/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([bB][oO][tT]|[cC][rR][aA][wW][lL]|[sS][pP][iI][dD][eE][rR]|[sS][lL][uU][rR][pP]|[fF][aA][cC][eE][bB][oO][oO][kK][eE][xX][tT][eE][rR][nN][aA][lL][hH][iI][tT]|[wW][hH][aA][tT][sS][aA][pP][pP]|[bB][iI][nN][gG][pP][rR][eE][vV][iI][eE][wW]|[gG][oO][oO][gG][lL][eE]-[sS][tT][rR][uU][cC][tT][uU][rR][eE][dD]-[dD][aA][tT][aA]-[tT][eE][sS][tT][iI][nN][gG]-[tT][oO][oO][lL]|[sS][nN][aA][pP][cC][hH][aA][tT]|[pP][iI][nN][tT][eE][rR][eE][sS][tT]|[mM][eE][tT][aA]-[eE][xX][tT][eE][rR][nN][aA][lL][aA][gG][eE][nN][tT]).*"
        }
      ],
      "destination": "https://outside-vip.onrender.com/events/:slug"
    },
    {
      "source": "/api/:path*",
      "destination": "https://outside-vip.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
